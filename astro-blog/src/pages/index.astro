---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const isProd = import.meta.env.PROD;
const posts = (await getCollection('blog', ({ data }) => !data.draft || !isProd))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateFmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Блог Honey Montana — гайды по IT, Python, QA и системному анализу"
  description="Практические статьи о старте в IT: Python, backend, тестирование, системный анализ, Linux, поиск работы. Пишем из опыта наставников и учеников."
>
  <section class="hero-block">
    <div class="container">
      <h1>Гайды и статьи</h1>
      <p>Разбираем то, что реально нужно джуну и мидлу: Python, QA, системный анализ, Linux, поиск работы в IT.</p>
    </div>
  </section>

  <section class="container">
    {posts.length === 0 ? (
      <p style="color: var(--muted)">Первые статьи скоро появятся.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-link" href={`${base}/${post.id}/`}>
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
              <span class="post-meta">
                <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
                {post.data.tags.length > 0 && <span class="dot">·</span>}
                {post.data.tags.map((tag, i) => (
                  <>
                    {i > 0 && <span class="dot">·</span>}
                    <span>#{tag}</span>
                  </>
                ))}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
